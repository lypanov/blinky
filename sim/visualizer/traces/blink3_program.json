  "mod_source": [
    "----- tests/AMemoryMappedToggle.Mod -----",
    "MODULE AMemoryMappedToggle;",
    "",
    "(* Module for memory-mapped light toggling *)",
    "",
    "VAR light*: INTEGER; (* Exported variable for light state *)",
    "",
    "(* Toggle the light state *)",
    "PROCEDURE Toggle*;",
    "BEGIN",
    "  light := 1 - light; (* toggle light, memory writes are intercepted *)",
    "END Toggle;",
    "",
    "BEGIN",
    "  light := 0; (* Initialize light to off *)",
    "END AMemoryMappedToggle. ",
    "",
    "----- tests/Blink3test.Mod  (LightToggle) -----",
    "MODULE LightToggle;",
    "",
    "IMPORT MMT := AMemoryMappedToggle;",
    "",
    "VAR counter: INTEGER;",
    "    maxIterations: INTEGER;",
    "",
    "BEGIN",
    "    counter := 0;",
    "    maxIterations := 262144;",
    "",
    "    WHILE TRUE DO",
    "        INC(counter);",
    "        IF counter >= maxIterations THEN",
    "            MMT.Toggle; (* Use the toggle function from the imported module *)",
    "            counter := 0;",
    "        END;",
    "    END;",
    "END LightToggle."
  ],
  "mod_file": "tests/Blink3test.Mod + AMemoryMappedToggle.Mod",
  "title": "Blink3 \u2014 AMMT BEGIN, then Toggle via BL (R15 = PC+4)",
  "subtitle": "Trampoline BLs stand in for Modules.Load body calls",
