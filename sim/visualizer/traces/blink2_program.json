  "mod_source": [
    "MODULE LightToggle;",
    "",
    "VAR light: INTEGER;",
    "    counter: INTEGER;",
    "    maxIterations: INTEGER;",
    "",
    "BEGIN",
    "    light := 0;",
    "    counter := 0;",
    "    maxIterations := 5;",
    "",
    "    WHILE TRUE DO",
    "        INC(counter);",
    "        IF counter >= maxIterations THEN",
    "            light := 1 - light; (* toggle light, memory writes are intercepted *)",
    "            counter := 0;",
    "        END;",
    "    END;",
    "END LightToggle."
  ],
  "mod_file": "tests/Blink2test.Mod",
  "title": "Blink2 \u2014 inlined toggle (this one works)",
  "subtitle": "Verilator playback of Blink2test \u00b7 unfixed CPU, no BL",
  "modules": [
