# LED output (bank 0 is 3.3 V on the Nano 4K)
IO_LOC "io_led" 10;
IO_PORT "io_led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

# S1 / KEY1, schematic Tang_Nano_4K_3603 pin 14 (IOB4B).
# 100 kΩ to 1.8 V, switch to GND, 100 nF to GND. Active-low.
# S2 is pin 15 and stays the reset input below.
IO_LOC "io_btn_n" 14;
IO_PORT "io_btn_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

# Reset: USR KEY pin 15. a68a501 used PULL_DOWN + Chisel active-high
# (unpressed = 0 = run). blinky_top does not invert this pin.
IO_LOC "reset" 15;
IO_PORT "reset" IO_TYPE=LVCMOS18 PULL_MODE=DOWN;

# Clock signal (27 MHz oscillator, LPLL_T_in)
IO_LOC "clock" 45;
IO_PORT "clock" IO_TYPE=LVCMOS33 PULL_MODE=UP;

# UART — Sipeed Tang Nano 4K header IOB13A / IOB13B.
# Gowin EMPU 4K examples use pin 19 as UART_TX; pin 18 is the adjacent RX.
IO_LOC "io_uart_tx" 19;
IO_PORT "io_uart_tx" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_LOC "io_uart_rx" 18;
IO_PORT "io_uart_rx" IO_TYPE=LVCMOS18 PULL_MODE=UP;

# External NOR, MSPI pins. Same locs as gowin/spi_flash.cst.
# WP# and HOLD# are driven high. The bitstream is not written here.
IO_LOC "spi_clk" 1;
IO_PORT "spi_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "spi_cs_n" 2;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "spi_mosi" 48;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "spi_miso" 47;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "spi_wp" 8;
IO_PORT "spi_wp" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "spi_hold" 9;
IO_PORT "spi_hold" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
