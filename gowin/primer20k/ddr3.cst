// Tang Primer 20K Dock, DDR3 data port. Clock H11. L14 is the blink
// pin (active-low). led[0]/led[1] are C13/A13, held on. DDR3 balls are
// the Dock placement that already talks to the onboard H5TQ1G63.

IO_LOC "Clock" H11;
IO_PORT "Clock" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "IO_voltage" L14;
IO_PORT "IO_voltage" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC "led[0]" C13;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[1]" A13;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[2]" N16;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[3]" N14;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[4]" L16;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// DDR pins
IO_LOC "DDR3_BA[2]" H5;
IO_PORT "DDR3_BA[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_BA[1]" D3;
IO_PORT "DDR3_BA[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_BA[0]" H4;
IO_PORT "DDR3_BA[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[13]" C8;
IO_PORT "DDR3_A[13]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[12]" A3;
IO_PORT "DDR3_A[12]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[11]" B7;
IO_PORT "DDR3_A[11]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[10]" K3;
IO_PORT "DDR3_A[10]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[9]" F9;
IO_PORT "DDR3_A[9]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[8]" A5;
IO_PORT "DDR3_A[8]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[7]" D8;
IO_PORT "DDR3_A[7]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[6]" B1;
IO_PORT "DDR3_A[6]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[5]" E6;
IO_PORT "DDR3_A[5]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[4]" C4;
IO_PORT "DDR3_A[4]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[3]" F8;
IO_PORT "DDR3_A[3]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[2]" D6;
IO_PORT "DDR3_A[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[1]" A4;
IO_PORT "DDR3_A[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_A[0]" F7;
IO_PORT "DDR3_A[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_ODT" R3;
IO_PORT "DDR3_ODT" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_CKE" J2;
IO_PORT "DDR3_CKE" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_nWE" L2;
IO_PORT "DDR3_nWE" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_nCAS" R6;
IO_PORT "DDR3_nCAS" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_nRAS" R4;
IO_PORT "DDR3_nRAS" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_nRESET" B9;
IO_PORT "DDR3_nRESET" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_CK" J1,J3;
IO_PORT "DDR3_CK" IO_TYPE=SSTL15D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[15]" M2;
IO_PORT "DDR3_DQ[15]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[14]" R1;
IO_PORT "DDR3_DQ[14]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[13]" H3;
IO_PORT "DDR3_DQ[13]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[12]" P4;
IO_PORT "DDR3_DQ[12]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[11]" L1;
IO_PORT "DDR3_DQ[11]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[10]" N2;
IO_PORT "DDR3_DQ[10]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[9]" K4;
IO_PORT "DDR3_DQ[9]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[8]" M3;
IO_PORT "DDR3_DQ[8]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[7]" B3;
IO_PORT "DDR3_DQ[7]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[6]" E1;
IO_PORT "DDR3_DQ[6]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[5]" C1;
IO_PORT "DDR3_DQ[5]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[4]" E2;
IO_PORT "DDR3_DQ[4]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[3]" F3;
IO_PORT "DDR3_DQ[3]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[2]" F4;
IO_PORT "DDR3_DQ[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[1]" F5;
IO_PORT "DDR3_DQ[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[0]" G5;
IO_PORT "DDR3_DQ[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQS[1]" J5,K6;
IO_PORT "DDR3_DQS[1]" IO_TYPE=SSTL15D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_DQS[0]" G2,G3;
IO_PORT "DDR3_DQS[0]" IO_TYPE=SSTL15D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_DM[1]" K5;
IO_PORT "DDR3_DM[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_DM[0]" G1;
IO_PORT "DDR3_DM[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_nCS" P5;
IO_PORT "DDR3_nCS" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;

// BL702 UART TX. Same ball and standard NESTang uses on this Dock.
IO_LOC "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
// BL702 UART RX. The host's TX. Press bytes land here. TX stays M11.
IO_LOC "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// Key S2. Bank 4, 1.5 V, active-low. S1 (T10) stays the reset key.
IO_LOC "btn_n" T3;
IO_PORT "btn_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;
// The button sampler's flops, left in the DDR3 corner, hold write-eye
// training (PC 0080, F=4B, dark LED). The DQS primitives sit at
// R56C45 (lane 1) and R56C12 (lane 0). Keep the sampler, and the
// CPU's -60 load flop, in the opposite corner.
GROUP gate_grp = {"u_gate*" "u_disk_rx*" "u_cpu/cpu/btnLoad*"};
GRP_LOC gate_grp R[2:22]C[2:18];
// The boot file's sector-word flops landed on the DDR3 rows and the
// write eye never saw the test byte (PC 0080, E0 FFFF, F 48/4B).
// secWordR is that word. Keep it with the sampler, away from the
// DQS at R56, and off R41/R43.
GROUP spi_grp = {"u_cpu/cpu/spi*" "u_cpu/cpu/body*" "u_cpu/cpu/secAddr*" "u_cpu/cpu/secWord*" "u_cpu/cpu/secPhase*" "u_cpu/cpu/sectorBase*"};
GRP_LOC spi_grp R[2:22]C[20:40];
// The 10:05 design still trains: ROM at BSRAM_R46[4], multiplier at
// DSP_R19[1] (R19C11). The 12:33 pin put the ROM at BSRAM_R28[7],
// beside the eye flops. That file trained at midday and now never
// sees the test byte. Keep the ROM on the site that still trains.
INS_LOC "u_cpu/cpu/instructionRom/mem_mem_0_0_s" BSRAM_R46[4];
INS_LOC "u_cpu/cpu/hwMul/n136_s0" DSP_R19[1];
// Row 28 sits on the DDR3 write flops. Twelve picture blocks there
// make the eye marginal (one load reaches the ROM, the next stays at
// F 4B). Keep them on row 10, clear of the sampler columns.
INS_LOC "u_video/g_bmp[0].u_bmp" BSRAM_R10[4];
INS_LOC "u_video/g_bmp[1].u_bmp" BSRAM_R10[5];
INS_LOC "u_video/g_bmp[2].u_bmp" BSRAM_R10[6];
INS_LOC "u_video/g_bmp[3].u_bmp" BSRAM_R10[7];
INS_LOC "u_video/g_bmp[4].u_bmp" BSRAM_R10[8];
INS_LOC "u_video/g_bmp[5].u_bmp" BSRAM_R10[9];
INS_LOC "u_video/g_bmp[6].u_bmp" BSRAM_R10[10];
INS_LOC "u_video/g_bmp[7].u_bmp" BSRAM_R10[11];
INS_LOC "u_video/g_bmp[8].u_bmp" BSRAM_R10[12];
INS_LOC "u_video/g_bmp[9].u_bmp" BSRAM_R10[13];
INS_LOC "u_video/g_bmp[10].u_bmp" BSRAM_R10[14];
INS_LOC "u_video/g_bmp[11].u_bmp" BSRAM_R10[15];
// The latched picture address. Left on the DDR3 rows, these flops
// keep the eye from starting (PC 0080, F 00). The sampler corner and
// the write rows are already taken. This pocket is below the sampler
// and left of the DQS.
GROUP bmp_addr = {"*bmpWordR*"};
GRP_LOC bmp_addr R16C[42:48];
// Rise tap and the gate, together. The rest of the chain sits two
// rows away so the fall path is longer than one pixel period.
GROUP fire_rise = {"*g_fire[0].u_dly*" "*g_fire[1].u_dly*" "*g_fire[2].u_dly*" "*g_fire[3].u_dly*" "*g_fire[4].u_dly*" "*u_fire_and*"};
GRP_LOC fire_rise R12C[42:48];
// The fall path has to cross the pocket four times. A packed chain is
// shorter than one pixel period, so a row of the square is skipped.
GROUP fire_a = {"*g_fire[5].u_dly*"};
GRP_LOC fire_a R14C36;
GROUP fire_b = {"*g_fire[6].u_dly*"};
GRP_LOC fire_b R22C48;
GROUP fire_c = {"*g_fire[7].u_dly*"};
GRP_LOC fire_c R14C48;
GROUP fire_d = {"*g_fire[8].u_dly*"};
GRP_LOC fire_d R22C36;
GROUP fire_e = {"*g_fire[9].u_dly*"};
GRP_LOC fire_e R12C36;
GROUP fire_fall = {"*g_fire[10].u_dly*" "*g_fire[11].u_dly*" "*g_fire[12].u_dly*" "*g_fire[13].u_dly*" "*g_fire[14].u_dly*" "*g_fire[15].u_dly*" "*g_fire[16].u_dly*" "*g_fire[17].u_dly*" "*g_fire[18].u_dly*" "*g_fire[19].u_dly*" "*g_fire[20].u_dly*" "*g_fire[21].u_dly*" "*g_fire[22].u_dly*" "*g_fire[23].u_dly*"};
GRP_LOC fire_fall R22C[40:46];
// The image that trains (route_option 1, ROM at BSRAM_R46[4]) has no
// registers on rows 48 or 49. An unconstrained place put dq_out,
// dq_oen, dqs_oen, dm_out_1, and dm_out_7 there, beside the DQS
// sites, and the eye never saw the test byte. One box from row 38
// packs every write flop onto that row. The trained image spreads
// the same flops over rows 38, 39, 40, 43, 45, and 47, columns
// 33-41, and dm_out_3 at R54C32 beside dqs_hold. Do not use these
// rows for the sampler or the sector word, and do not move the ROM
// off BSRAM_R46[4]. This netlist names the output enables
// dq_oen_0 and dq_oen_3. The replica suffix flips when the
// receiver counter is added, so the pattern keeps either suffix.
GROUP wr38 = {"*dm_out_0_s0*" "*dm_out_2_s0*" "*dq_out[2]_0_s0*" "*dq_out[2]_5_s0*" "*dq_out[2]_7_s0*" "*dq_out[7]_0_s0*" "*dq_out[7]_5_s0*" "*dq_out[7]_7_s0*"};
GRP_LOC wr38 R38C[33:35];
GROUP wr39 = {"*dq_out[2]_1_s0*" "*dq_out[2]_3_s0*" "*dq_out[2]_4_s0*" "*dq_out[2]_6_s0*" "*dq_out[7]_1_s0*" "*dq_out[7]_3_s0*" "*dq_out[7]_4_s0*" "*dq_out[7]_6_s0*"};
GRP_LOC wr39 R39C[33:35];
GROUP wr40 = {"*dq_out[2]_2_s0*" "*dq_out[2]_13_s0*" "*dq_out[7]_2_s0*" "*dq_out[7]_13_s0*"};
GRP_LOC wr40 R40C[33:35];
GROUP wr43 = {"*dm_out_1_s0*" "*dm_out_7_s0*"};
GRP_LOC wr43 R43C[34:36];
GROUP wr45 = {"*dq_oen_3_s*" "*dqs_oen_0_s0*" "*dqs_oen_3_s0*"};
GRP_LOC wr45 R45C[33:39];
GROUP wr47 = {"*dq_oen_0_s*" "*dqs_oen_2_s0*" "*dq_out[2]_8_s0*" "*dq_out[2]_9_s0*" "*dq_out[2]_10_s0*" "*dq_out[2]_11_s0*" "*dq_out[2]_12_s0*" "*dq_out[2]_14_s0*" "*dq_out[2]_15_s0*" "*dq_out[7]_8_s0*" "*dq_out[7]_9_s0*" "*dq_out[7]_10_s0*" "*dq_out[7]_11_s0*" "*dq_out[7]_12_s0*" "*dq_out[7]_14_s0*" "*dq_out[7]_15_s0*"};
GRP_LOC wr47 R47C[33:41];
GROUP w5432 = {"*dm_out_3_s1*"};
GRP_LOC w5432 R54C32;
// The millisecond counter sat on row 8 in the image that trains.
// This place put all 16 flops on rows 43-44, column 31, one column
// from the DQ flops. The bridge's got flag was at R4C17.
GROUP ms_grp = {"*msPhase*"};
GRP_LOC ms_grp R8C[20:30];
// The sampler box fills R4C[16:18], so this netlist cannot put
// got_s0 there. The top-right pocket is clear of the write rows.
// got_s0 at R2C[42:48] is the place whose eye reads E0 A55A.
// The disk receiver stays in the sampler group above. A second
// group on those flops has no site in common with it.
GROUP got_grp = {"*got_s0*"};
GRP_LOC got_grp R2C[42:48];
// This netlist has no got_s4. got_s0 stays in the group.
// The same image keeps the PC on rows 38-44, columns 20-28, next
// to the ROM. Left free, this netlist puts it on rows 23-29. The
// columns stay clear of the write flops above.
GROUP pc38 = {"*pc_26_s0*" "*pc_27_s0*" "*pc_28_s0*" "*pc_30_s0*" "*pc_31_s0*"};
GRP_LOC pc38 R38C[20:30];
GROUP pc40 = {"*pc_11_s0*" "*pc_12_s0*" "*pc_13_s0*" "*pc_16_s0*" "*pc_17_s0*" "*pc_23_s0*" "*pc_29_s0*"};
GRP_LOC pc40 R40C[20:30];
GROUP pc41 = {"*pc_8_s0*" "*pc_10_s0*" "*pc_15_s0*" "*pc_20_s0*" "*pc_21_s0*" "*pc_22_s0*"};
GRP_LOC pc41 R41C[20:30];
GROUP pc42 = {"*pc_9_s0*" "*pc_14_s0*"};
GRP_LOC pc42 R42C[20:30];
// pc_30_s7 is not in this netlist. pc_30_s4 is a LUT, not a flop.
// pc_30_s0 stays on row 38.
GROUP pc43 = {"*pc_6_s0*" "*pc_7_s0*" "*pc_18_s0*" "*pc_19_s0*" "*pc_24_s0*" "*pc_25_s0*"};
GRP_LOC pc43 R43C[20:30];
GROUP pc44 = {"*pc_2_s0*" "*pc_3_s0*" "*pc_4_s0*" "*pc_5_s0*"};
GRP_LOC pc44 R44C[20:28];
// The font shadow is twelve SDPB on the pixel clock, the same clock
// as the picture. A CPU-clock write port drags the DDR3 write off and
// the CPU leaves the boot ROM. Row 46 stays the ROM. These sites are
// the free end of row 10 and the low end of row 28.
INS_LOC "u_video/g_shad[0].u_shad" BSRAM_R10[0];
INS_LOC "u_video/g_shad[1].u_shad" BSRAM_R10[1];
INS_LOC "u_video/g_shad[2].u_shad" BSRAM_R10[2];
INS_LOC "u_video/g_shad[3].u_shad" BSRAM_R10[3];
INS_LOC "u_video/g_shad[4].u_shad" BSRAM_R28[0];
INS_LOC "u_video/g_shad[5].u_shad" BSRAM_R28[1];
INS_LOC "u_video/g_shad[6].u_shad" BSRAM_R28[2];
INS_LOC "u_video/g_shad[7].u_shad" BSRAM_R28[3];
INS_LOC "u_video/g_shad[8].u_shad" BSRAM_R28[4];
INS_LOC "u_video/g_shad[9].u_shad" BSRAM_R28[5];
INS_LOC "u_video/g_shad[10].u_shad" BSRAM_R28[6];
INS_LOC "u_video/g_shad[11].u_shad" BSRAM_R28[7];
INS_LOC "u_cpu/cpu/snap/u_snap" BSRAM_R28[13];
