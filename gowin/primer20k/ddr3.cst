// The sampler box fills R4C[16:18], so this netlist cannot put
// got_s0 there. The top-right pocket is clear of the write rows.
// got_s0 at R2C[42:48] is the place whose eye reads E0 A55A.
// The disk receiver stays in the sampler group above. A second
// group on those flops has no site in common with it.
GROUP got_grp = {"*got_s0*"};
GRP_LOC got_grp R2C[42:48];
// This netlist has no got_s4. got_s0 stays in the group.
// The same image keeps the PC on rows 38-44, columns 20-28, next
// to the ROM. Left free, this netlist puts it on rows 23-29. The
// columns stay clear of the write flops above.
GROUP pc38 = {"*pc_26_s0*" "*pc_27_s0*" "*pc_28_s0*" "*pc_30_s0*" "*pc_31_s0*"};
GRP_LOC pc38 R38C[20:30];
GROUP pc40 = {"*pc_11_s0*" "*pc_12_s0*" "*pc_13_s0*" "*pc_16_s0*" "*pc_17_s0*" "*pc_23_s0*" "*pc_29_s0*"};
GRP_LOC pc40 R40C[20:30];
GROUP pc41 = {"*pc_8_s0*" "*pc_10_s0*" "*pc_15_s0*" "*pc_20_s0*" "*pc_21_s0*" "*pc_22_s0*"};
GRP_LOC pc41 R41C[20:30];
GROUP pc42 = {"*pc_9_s0*" "*pc_14_s0*"};
GRP_LOC pc42 R42C[20:30];
// pc_30_s7 is not in this netlist. pc_30_s4 is a LUT, not a flop.
// pc_30_s0 stays on row 38.
GROUP pc43 = {"*pc_6_s0*" "*pc_7_s0*" "*pc_18_s0*" "*pc_19_s0*" "*pc_24_s0*" "*pc_25_s0*"};
GRP_LOC pc43 R43C[20:30];
GROUP pc44 = {"*pc_2_s0*" "*pc_3_s0*" "*pc_4_s0*" "*pc_5_s0*"};
GRP_LOC pc44 R44C[20:28];
// The font shadow is twelve SDPB on the pixel clock, the same clock
// as the picture. A CPU-clock write port drags the DDR3 write off and
// the CPU leaves the boot ROM. Row 46 stays the ROM. These sites are
// the free end of row 10 and the low end of row 28.
INS_LOC "u_video/g_shad[0].u_shad" BSRAM_R10[0];
INS_LOC "u_video/g_shad[1].u_shad" BSRAM_R10[1];
INS_LOC "u_video/g_shad[2].u_shad" BSRAM_R10[2];
