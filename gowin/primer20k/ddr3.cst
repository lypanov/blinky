IO_PORT "DDR3_DQ[10]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[9]" K4;
IO_PORT "DDR3_DQ[9]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[8]" M3;
IO_PORT "DDR3_DQ[8]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[7]" B3;
IO_PORT "DDR3_DQ[7]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[6]" E1;
IO_PORT "DDR3_DQ[6]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[5]" C1;
IO_PORT "DDR3_DQ[5]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[4]" E2;
IO_PORT "DDR3_DQ[4]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[3]" F3;
IO_PORT "DDR3_DQ[3]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[2]" F4;
IO_PORT "DDR3_DQ[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[1]" F5;
IO_PORT "DDR3_DQ[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQ[0]" G5;
IO_PORT "DDR3_DQ[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC "DDR3_DQS[1]" J5,K6;
IO_PORT "DDR3_DQS[1]" IO_TYPE=SSTL15D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_DQS[0]" G2,G3;
IO_PORT "DDR3_DQS[0]" IO_TYPE=SSTL15D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_DM[1]" K5;
IO_PORT "DDR3_DM[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_DM[0]" G1;
IO_PORT "DDR3_DM[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "DDR3_nCS" P5;
IO_PORT "DDR3_nCS" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;

// BL702 UART TX. Same ball and standard NESTang uses on this Dock.
IO_LOC "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
// BL702 UART RX. The host's TX. Press bytes land here. TX stays M11.
IO_LOC "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// Key S2. Bank 4, 1.5 V, active-low. S1 (T10) stays the reset key.
IO_LOC "btn_n" T3;
IO_PORT "btn_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;
// The button sampler's flops, left in the DDR3 corner, hold write-eye
// training (PC 0080, F=4B, dark LED). The DQS primitives sit at
// R56C45 (lane 1) and R56C12 (lane 0). Keep the sampler, and the
// CPU's -60, -40, and -36 load flops, in the opposite corner.
GROUP gate_grp = {"u_gate*" "u_disk_rx*" "u_cpu/cpu/btnLoad*" "u_cpu/cpu/msLoad*" "u_cpu/cpu/kbdLoad*"};
GRP_LOC gate_grp R[2:22]C[2:18];
// The boot file's sector-word flops landed on the DDR3 rows and the
// write eye never saw the test byte (PC 0080, E0 FFFF, F 48/4B).
// secWordR is that word. Keep it with the sampler, away from the
// DQS at R56, and off R41/R43.
GROUP spi_grp = {"u_cpu/cpu/spi*" "u_cpu/cpu/body*" "u_cpu/cpu/secAddr*" "u_cpu/cpu/secWord*" "u_cpu/cpu/secPhase*" "u_cpu/cpu/sectorBase*"};
GRP_LOC spi_grp R[2:22]C[20:40];
// The 10:05 design still trains: ROM at BSRAM_R46[4], multiplier at
// DSP_R19[1] (R19C11). The 12:33 pin put the ROM at BSRAM_R28[7],
// beside the eye flops. That file trained at midday and now never
// sees the test byte. Keep the ROM on the site that still trains.
INS_LOC "u_cpu/cpu/instructionRom/mem_mem_0_0_s" BSRAM_R46[4];
INS_LOC "u_cpu/cpu/hwMul/n136_s0" DSP_R19[1];
// Row 28 sits on the DDR3 write flops. Twelve picture blocks there
// make the eye marginal (one load reaches the ROM, the next stays at
// F 4B). Keep them on row 10, clear of the sampler columns.
INS_LOC "u_video/g_bmp[0].u_bmp" BSRAM_R10[4];
INS_LOC "u_video/g_bmp[1].u_bmp" BSRAM_R10[5];
INS_LOC "u_video/g_bmp[2].u_bmp" BSRAM_R10[6];
INS_LOC "u_video/g_bmp[3].u_bmp" BSRAM_R10[7];
INS_LOC "u_video/g_bmp[4].u_bmp" BSRAM_R10[8];
INS_LOC "u_video/g_bmp[5].u_bmp" BSRAM_R10[9];
INS_LOC "u_video/g_bmp[6].u_bmp" BSRAM_R10[10];
INS_LOC "u_video/g_bmp[7].u_bmp" BSRAM_R10[11];
INS_LOC "u_video/g_bmp[8].u_bmp" BSRAM_R10[12];
INS_LOC "u_video/g_bmp[9].u_bmp" BSRAM_R10[13];
INS_LOC "u_video/g_bmp[10].u_bmp" BSRAM_R10[14];
INS_LOC "u_video/g_bmp[11].u_bmp" BSRAM_R10[15];
// The latched picture address. Left on the DDR3 rows, these flops
// keep the eye from starting (PC 0080, F 00, lanes 00EB, E0 0000).
// bmpWordR is the store address. bmpAddrHold is the read address,
// and this place left it on the DDR3 rows. The sampler corner and
// the write rows are already taken. This pocket is below the sampler
// and left of the DQS. Seven columns hold 28 registers; the two
// 13-bit addresses use 26.
GROUP bmp_addr = {"*bmpWordR*" "*bmpAddrHold*"};
GRP_LOC bmp_addr R16C[42:48];
// This place left the bridge data flops on the write rows (wdata at
// R41C13, R44C13 and R45C14, the port sync beside them). The lanes
// then froze at 00EB with E0 0000 and the CPU stayed at PC 0080.
// Packing that path on top of the sector-word box let write leveling
// finish, then the eye read 010C (E0 FFFF, F 4B). got_s0 stays in
// its own pocket. state_2 stays at R9C45. The sector box stays
// R[2:22]C[20:40]. This strip is below that box and left of the
// write columns. The status UART flops had landed on the write rows
// with the bridge; they come along.
GROUP bridge_lo = {"u_cpu/bridge/wdata*" "u_cpu/bridge/lo_*" "u_cpu/bridge/hi_*" "u_cpu/bridge/baseAddr*" "u_cpu/bridge/hold*" "u_cpu/bridge/refCnt*" "u_cpu/bridge/gap*" "u_cpu/bridge/doneCnt*" "u_cpu/bridge/resume*" "u_cpu/bridge/sawBusy*" "u_cpu/bridge/cmdRef*" "u_cpu/bridge/isWrite*" "u_cpu/bridge/isByte*" "u_cpu/bridge/pend*" "u_cpu/bridge/phase*" "u_cpu/sync/*" "u_cpu/align/*" "*bmpPhase*" "u_uart/*" "tx_data*"};
GRP_LOC bridge_lo R[23:36]C[2:35];
// Rise tap and the gate, together. The rest of the chain sits two
// rows away so the fall path is longer than one pixel period.
GROUP fire_rise = {"*g_fire[0].u_dly*" "*g_fire[1].u_dly*" "*g_fire[2].u_dly*" "*g_fire[3].u_dly*" "*g_fire[4].u_dly*" "*u_fire_and*"};
GRP_LOC fire_rise R12C[42:48];
// The fall path has to cross the pocket four times. A packed chain is
// shorter than one pixel period, so a row of the square is skipped.
GROUP fire_a = {"*g_fire[5].u_dly*"};
GRP_LOC fire_a R14C36;
GROUP fire_b = {"*g_fire[6].u_dly*"};
GRP_LOC fire_b R22C48;
GROUP fire_c = {"*g_fire[7].u_dly*"};
GRP_LOC fire_c R14C48;
GROUP fire_d = {"*g_fire[8].u_dly*"};
GRP_LOC fire_d R22C36;
GROUP fire_e = {"*g_fire[9].u_dly*"};
GRP_LOC fire_e R12C36;
GROUP fire_fall = {"*g_fire[10].u_dly*" "*g_fire[11].u_dly*" "*g_fire[12].u_dly*" "*g_fire[13].u_dly*" "*g_fire[14].u_dly*" "*g_fire[15].u_dly*" "*g_fire[16].u_dly*" "*g_fire[17].u_dly*" "*g_fire[18].u_dly*" "*g_fire[19].u_dly*" "*g_fire[20].u_dly*" "*g_fire[21].u_dly*" "*g_fire[22].u_dly*" "*g_fire[23].u_dly*"};
GRP_LOC fire_fall R22C[40:46];
// The image that trains (route_option 1, ROM at BSRAM_R46[4]) has no
// registers on rows 48 or 49. An unconstrained place put dq_out,
// dq_oen, dqs_oen, dm_out_1, and dm_out_7 there, beside the DQS
// sites, and the eye never saw the test byte. One box from row 38
// packs every write flop onto that row. The trained image spreads
// the same flops over rows 38, 39, 40, 43, 45, and 47, columns
// 33-41, and dm_out_3 at R54C32 beside dqs_hold. Do not use these
// rows for the sampler or the sector word, and do not move the ROM
// off BSRAM_R46[4]. This netlist names the output enables
// dq_oen_0 and dq_oen_3. The replica suffix flips when the
// receiver counter is added, so the pattern keeps either suffix.
GROUP wr38 = {"*dm_out_0_s0*" "*dm_out_2_s0*" "*dq_out[2]_0_s0*" "*dq_out[2]_5_s0*" "*dq_out[2]_7_s0*" "*dq_out[7]_0_s0*" "*dq_out[7]_5_s0*" "*dq_out[7]_7_s0*"};
GRP_LOC wr38 R38C[33:35];
GROUP wr39 = {"*dq_out[2]_1_s0*" "*dq_out[2]_3_s0*" "*dq_out[2]_4_s0*" "*dq_out[2]_6_s0*" "*dq_out[7]_1_s0*" "*dq_out[7]_3_s0*" "*dq_out[7]_4_s0*" "*dq_out[7]_6_s0*"};
GRP_LOC wr39 R39C[33:35];
GROUP wr40 = {"*dq_out[2]_2_s0*" "*dq_out[2]_13_s0*" "*dq_out[7]_2_s0*" "*dq_out[7]_13_s0*"};
GRP_LOC wr40 R40C[33:35];
GROUP wr43 = {"*dm_out_1_s0*" "*dm_out_7_s0*"};
GRP_LOC wr43 R43C[34:36];
GROUP wr45 = {"*dq_oen_3_s*" "*dqs_oen_0_s0*" "*dqs_oen_3_s0*"};
GRP_LOC wr45 R45C[33:39];
GROUP wr47 = {"*dq_oen_0_s*" "*dqs_oen_2_s0*" "*dq_out[2]_8_s0*" "*dq_out[2]_9_s0*" "*dq_out[2]_10_s0*" "*dq_out[2]_11_s0*" "*dq_out[2]_12_s0*" "*dq_out[2]_14_s0*" "*dq_out[2]_15_s0*" "*dq_out[7]_8_s0*" "*dq_out[7]_9_s0*" "*dq_out[7]_10_s0*" "*dq_out[7]_11_s0*" "*dq_out[7]_12_s0*" "*dq_out[7]_14_s0*" "*dq_out[7]_15_s0*"};
GRP_LOC wr47 R47C[33:41];
GROUP w5432 = {"*dm_out_3_s1*"};
GRP_LOC w5432 R54C32;
// This place put the command-cycle counter at R48C19. The image
// that trains has no registers on rows 48 or 49, and a counter
// there leaves the eye scanning with E0 0000. Row 30 is below the
// sampler box and clear of the write rows.
GROUP cycle_grp = {"*cycle_*_s0*"};
GRP_LOC cycle_grp R30C[8:12];
// This place put the bridge state flop at R48C31, one column from
// the DQ flops. The eye stays at E0 0000 and the lanes stay 00EB.
// The image that trains keeps that flop at R9C45.
GROUP bridge_st = {"u_cpu/bridge/state_2_s1"};
GRP_LOC bridge_st R9C45;
// Rows 48 and 49 stay empty of registers. A flop there leaves the
// eye at E0 0000. Each grid has four CLS. Reserve every register;
// LUTs and routing remain.
LOC_RESERVE R48C2[0] -REG;
LOC_RESERVE R48C2[1] -REG;
LOC_RESERVE R48C2[2] -REG;
LOC_RESERVE R48C2[3] -REG;
