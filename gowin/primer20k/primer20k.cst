// Tang Primer 20K Dock. Device: GW2A-LV18PG256C8/I7 (GW2A-18C).
// Wiki blink example: Clock H11, IO_voltage L14, LVCMOS33.
// led[5:0] are the six active-low user LEDs (same toggle as L14).

IO_LOC "Clock" H11;
IO_PORT "Clock" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Wiki pin (Orange_LED4 / L14). The other five user LEDs get the same toggle.
IO_LOC "IO_voltage" L14;
IO_PORT "IO_voltage" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC "led[0]" C13;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[1]" A13;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[2]" N16;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[3]" N14;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[4]" L16;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
